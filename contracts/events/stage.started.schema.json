{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragfun.local/contracts/events/stage.started.schema.json",
  "title": "Event stage.started",
  "description": "Producer: worker. Transport: Redis pub/sub channel 'events:{run_id}', message = this JSON (UTF-8). Consumer: api, which relays it unchanged as an SSE message with 'event: stage.started' and 'data: <json>' on GET /api/v1/events?run_id=\u2026; consumer of that: web. Delivery: at-most-once, no replay \u2014 clients refetch GET /stage-runs/{id} on (re)connect. Worker began the job (after loading inputs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "run_id",
    "stage_run_id",
    "stage",
    "version",
    "ts"
  ],
  "properties": {
    "type": {
      "const": "stage.started"
    },
    "run_id": {
      "$ref": "../shared/common.schema.json#/$defs/Id"
    },
    "stage_run_id": {
      "$ref": "../shared/common.schema.json#/$defs/Id"
    },
    "stage": {
      "$ref": "../shared/common.schema.json#/$defs/Stage"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "$ref": "../shared/common.schema.json#/$defs/Timestamp"
    }
  },
  "examples": [
    {
      "run_id": "019a4b2c-2000-7c00-9000-000000000002",
      "stage_run_id": "019a4b2c-2100-7c00-9000-000000000003",
      "stage": "chunk",
      "version": 1,
      "ts": "2026-11-01T18:22:05.123Z",
      "type": "stage.started"
    }
  ]
}
