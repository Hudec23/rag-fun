{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragfun.local/contracts/jobs/transform.schema.json",
  "title": "Job payload: transform",
  "description": "Producer: api. Consumer: worker (arq queue 'query', function name 'transform', called as transform(ctx, payload)). Delivery: at-least-once (arq), idempotency key stage_run_id. Artifact written to artifacts/{run_id}/transform/v{version}.json. On finish the worker POSTs /internal/v1/stage-results, then publishes stage.completed or stage.failed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage_run_id",
    "run_id",
    "run_kind",
    "stage",
    "version",
    "params",
    "question",
    "chat"
  ],
  "properties": {
    "stage_run_id": {
      "$ref": "../shared/common.schema.json#/$defs/Id",
      "description": "stage_runs.id; idempotency key \u2014 the worker may receive a job twice; the api ignores a second result for a stage run that is already done/failed."
    },
    "run_id": {
      "$ref": "../shared/common.schema.json#/$defs/Id",
      "description": "ingest_runs.id or query_runs.id."
    },
    "run_kind": {
      "const": "query"
    },
    "stage": {
      "const": "transform"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "params": {
      "$ref": "../shared/common.schema.json#/$defs/TransformParams"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "chat": {
      "$ref": "../shared/common.schema.json#/$defs/ChatModelConfig"
    }
  },
  "examples": [
    {
      "stage_run_id": "019a4b2c-2100-7c00-9000-000000000003",
      "run_id": "019a4b2c-2000-7c00-9000-000000000002",
      "run_kind": "query",
      "stage": "transform",
      "version": 1,
      "params": {
        "strategy": "multi_query",
        "num_queries": 3
      },
      "question": "How did revenue change in Q3?",
      "chat": {
        "provider": "ollama",
        "model": "qwen3:8b",
        "base_url": "http://host.docker.internal:11434",
        "api_key": null
      }
    }
  ]
}
