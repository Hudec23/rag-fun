{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragfun.local/contracts/jobs/retrieve.schema.json",
  "title": "Job payload: retrieve",
  "description": "Producer: api. Consumer: worker (arq queue 'query', function name 'retrieve', called as retrieve(ctx, payload)). Delivery: at-least-once (arq), idempotency key stage_run_id. Artifact written to artifacts/{run_id}/retrieve/v{version}.json. On finish the worker POSTs /internal/v1/stage-results, then publishes stage.completed or stage.failed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage_run_id",
    "run_id",
    "run_kind",
    "stage",
    "version",
    "params",
    "question",
    "transform_artifact_key",
    "collection"
  ],
  "properties": {
    "stage_run_id": {
      "$ref": "../shared/common.schema.json#/$defs/Id",
      "description": "stage_runs.id; idempotency key \u2014 the worker may receive a job twice; the api ignores a second result for a stage run that is already done/failed."
    },
    "run_id": {
      "$ref": "../shared/common.schema.json#/$defs/Id",
      "description": "ingest_runs.id or query_runs.id."
    },
    "run_kind": {
      "const": "query"
    },
    "stage": {
      "const": "retrieve"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "params": {
      "$ref": "../shared/common.schema.json#/$defs/RetrieveParams"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "transform_artifact_key": {
      "oneOf": [
        {
          "$ref": "../shared/common.schema.json#/$defs/S3Key"
        },
        {
          "type": "null"
        }
      ],
      "description": "Active transform artifact; null when transform was never run \u2192 queries = [question]."
    },
    "collection": {
      "$ref": "../shared/common.schema.json#/$defs/CollectionRef"
    }
  },
  "examples": [
    {
      "stage_run_id": "019a4b2c-2100-7c00-9000-000000000003",
      "run_id": "019a4b2c-2000-7c00-9000-000000000002",
      "run_kind": "query",
      "stage": "retrieve",
      "version": 1,
      "params": {
        "mode": "hybrid",
        "top_k": 10,
        "rrf_k": 60,
        "filters": {
          "must": [
            {
              "key": "tags",
              "match": {
                "any": [
                  "finance"
                ]
              }
            }
          ]
        }
      },
      "question": "How did revenue change in Q3?",
      "transform_artifact_key": "019a4b2c-2000-7c00-9000-000000000002/transform/v1.json",
      "collection": {
        "id": "019a4b2c-1d00-7b00-8000-0000000000aa",
        "qdrant_name": "rf_019a4b2c1d007b0080000000000000aa",
        "dense": {
          "model": "bge-m3",
          "dims": 1024,
          "ollama_url": "http://host.docker.internal:11434"
        },
        "sparse_model": "Qdrant/bm25"
      }
    }
  ]
}
