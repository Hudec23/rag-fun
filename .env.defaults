# Preset configuration for docker-compose.yml. Override any value in an optional .env file (gitignored).
DATABASE_URL=postgresql+asyncpg://ragfun:ragfun@postgres:5432/ragfun
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://s3:9000
S3_ACCESS_KEY=ragfun
S3_SECRET_KEY=ragfun-secret
S3_BUCKET_UPLOADS=uploads
S3_BUCKET_ARTIFACTS=artifacts
QDRANT_URL=http://qdrant:6333
INTERNAL_TOKEN=dev-internal-token
API_INTERNAL_URL=http://api:8000
OLLAMA_URL_DEFAULT=http://host.docker.internal:11434
MAX_UPLOAD_MB=50
MAX_FILES_PER_BATCH=20
MODEL_BACKEND=real
LOG_LEVEL=INFO
