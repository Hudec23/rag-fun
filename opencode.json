{
  "$schema": "https://opencode.ai/config.json",
  "model": "vllm/local",
  "small_model": "vllm/local",
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (llm-neatly)",
      "options": {
        "baseURL": "{env:VLLM_BASE_URL}/v1",
        "apiKey": "{env:VLLM_API_KEY}"
      },
      "models": {
        "local": {
          "name": "Local: whatever profile is running",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "vllm/local"
    },
    "plan": {
      "model": "anthropic/claude-opus-5-5"
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf /*": "deny",
      "sudo *": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "brave-search": {
      "type": "remote",
      "url": "https://mcp.brave.com/mcp",
      "headers": { "Authorization": "Bearer {env:BRAVE_API_SEARCH_KEY}" }
    }
  }
}